@FirstAidAPI_HostAddress = http://localhost:5085

GET {{FirstAidAPI_HostAddress}}/weatherforecast/
Accept: application/json

###

# Get all events
GET {{FirstAidAPI_HostAddress}}/events
Accept: application/json

###

# Get event by ID
GET {{FirstAidAPI_HostAddress}}/events/1
Accept: application/json

###

# Create a new event
POST {{FirstAidAPI_HostAddress}}/events
Content-Type: application/json

{
  "name": "Sample Event",
  "startDate": "2026-12-01T10:00:00Z",
  "endDate": "2026-12-01T14:00:00Z",
  "location": "Sample Location",
  "description": "A sample event for testing"
}

###

# Update an event
PUT {{FirstAidAPI_HostAddress}}/events/1
Content-Type: application/json

{
  "id": 1,
  "name": "Updated Sample Event",
  "startDate": "2024-12-01T10:00:00Z",
  "endDate": "2024-12-01T14:00:00Z",
  "location": "Updated Location",
  "description": "Updated description"
}

###

# Cancel an event
DELETE {{FirstAidAPI_HostAddress}}/events/1

###

# Get shift by ID
GET {{FirstAidAPI_HostAddress}}/shifts/1
Accept: application/json

###

# Create a new shift
POST {{FirstAidAPI_HostAddress}}/shifts
Content-Type: application/json

{
  "eventId": 1,
  "name": "Sample Shift",
  "startTime": "2024-12-01T10:00:00Z",
  "endTime": "2024-12-01T12:00:00Z",
  "requiredStaff": 2,
  "description": "A sample shift for testing"
}

###

# Update a shift
PUT {{FirstAidAPI_HostAddress}}/shifts/1
Content-Type: application/json

{
  "id": 1,
  "eventId": 1,
  "name": "Updated Sample Shift",
  "startTime": "2024-12-01T10:00:00Z",
  "endTime": "2024-12-01T12:00:00Z",
  "requiredStaff": 3,
  "description": "Updated shift description"
}

###

# Cancel a shift
DELETE {{FirstAidAPI_HostAddress}}/shifts/1

###

# Get all staff
GET {{FirstAidAPI_HostAddress}}/staff
Accept: application/json

###

# Get staff by ID
GET {{FirstAidAPI_HostAddress}}/staff/1
Accept: application/json

###

# Create a new staff member
POST {{FirstAidAPI_HostAddress}}/staff
Content-Type: application/json

{
  "firstName": "June",
  "lastName": "Doe",
  "email": "june.doe@example.com",
  "phone": "+1234567890",
  "role": "FirstAider",
  "certificationLevel": "Basic",
  "certificationExpiry": "2025-12-01T00:00:00Z"
}

###

# Update a staff member
PUT {{FirstAidAPI_HostAddress}}/staff/1
Content-Type: application/json

{
  "id": 1,
  "firstName": "John",
  "lastName": "Smith",
  "email": "john.smith@example.com",
  "phone": "+1234567890",
  "role": "FirstAider",
  "certificationLevel": "Advanced",
  "certificationExpiry": "2026-12-01T00:00:00Z"
}

###

# Resign a staff member
DELETE {{FirstAidAPI_HostAddress}}/staff/1

###

# Get all shifts for an event
GET {{FirstAidAPI_HostAddress}}/events/1/shifts
Accept: application/json

###

# Create a new shift for an event
POST {{FirstAidAPI_HostAddress}}/events/1/shifts
Content-Type: application/json

{
  "name": "Sample Shift for Event",
  "startTime": "2024-12-01T10:00:00Z",
  "endTime": "2024-12-01T12:00:00Z",
  "requiredStaff": 2,
  "description": "A sample shift for testing under event"
}

###

# Get a specific shift for an event
GET {{FirstAidAPI_HostAddress}}/events/1/shifts/1
Accept: application/json

###

# Update a shift for an event
PUT {{FirstAidAPI_HostAddress}}/events/1/shifts/1
Content-Type: application/json

{
  "id": 1,
  "eventId": 1,
  "name": "Updated Sample Shift for Event",
  "startTime": "2024-12-01T10:00:00Z",
  "endTime": "2024-12-01T12:00:00Z",
  "requiredStaff": 3,
  "description": "Updated shift description for event"
}

###

# Cancel a shift for an event
DELETE {{FirstAidAPI_HostAddress}}/events/1/shifts/1

###

# Add staff to a shift
POST {{FirstAidAPI_HostAddress}}/shifts/1/staff/1

###

# Remove staff from a shift
DELETE {{FirstAidAPI_HostAddress}}/shifts/1/staff/1

###
